#!/bin/sh
set -u

printf '%s\n' 'Agent path (headless; no browser required):'
/home/agent/.local/bin/ij status || true

printf '\n%s\n' 'Optional browser editor:'
if curl -fsS -o /dev/null http://127.0.0.1:8080/; then
  printf '%s\n' 'READY: code-server is responding on container port 8080.'
else
  printf '%s\n' 'NOT READY: inspect /tmp/ij-lsp-code-server.log.'
fi

printf '\n%s\n' 'Installed code-server extensions:'
code-server --list-extensions --show-versions 2>&1 || true
